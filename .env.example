# Environment
# Setup .env For Github Pages () Settings → Secrets and variables → Actions → Variables )

VITE_NODE_ENV=local
VITE_NODE_PUBLIC_URL=http://localhost:3000
VITE_NODE_BUILD_VERSION=1.0.0

# API Configuration
VITE_API_URL=http://localhost:2003
VITE_API_CLIENT_KEY="owner_client_keyxxxxxxxxxx"
VITE_API_SECRET_KEY="owner_secret_keyxxxxxxxxxx"

# Encryption
VITE_ENCRYPT_KEY="keyxxxxxxxxxx"

# Localization
VITE_DEFAULT_LANGUAGE="km"

# Hotjar Analytics
VITE_HOTJAR_ID="1234567"

# -----------------------------
# CAPTCHA (Turnstile)
# -----------------------------
VITE_TURNSTILE_SITE_KEY="0xxxxxxx"

